<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        The parent POM from Spring Boot provides:
        - Dependency version management (no need to specify versions for most Spring libs)
        - Default plugin configurations (maven-compiler-plugin, maven-surefire-plugin, etc.)
        - Sensible defaults for packaging and testing
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- Project coordinates: uniquely identify this artifact in Maven repositories -->
    <groupId>com.example</groupId>
    <artifactId>employeemanagement</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Employee Management System</name>
    <description>Production-style REST API for managing employees</description>

    <properties>
        <!-- Tells Maven compiler and Spring Boot to use Java 17 -->
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!--
            spring-boot-starter-web:
            Bundles Spring MVC + embedded Tomcat + Jackson (JSON serialization).
            This is what makes your class a web server without deploying a WAR.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-data-jpa:
            Bundles Spring Data JPA + Hibernate (JPA implementation) + Spring ORM.
            Gives you JpaRepository, @Entity support, and transaction management.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            spring-boot-starter-validation:
            Bundles Hibernate Validator (Bean Validation 3.0 implementation).
            Enables @NotBlank, @Email, @Positive, @Valid on your DTOs.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            mysql-connector-j:
            The JDBC driver that allows Java to communicate with MySQL.
            Spring Boot's DataSource auto-configuration uses this at runtime.
            scope=runtime means it's not needed at compile time, only when running.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            lombok:
            An annotation processor that generates boilerplate at compile time:
            @Getter/@Setter → generates getters/setters
            @NoArgsConstructor → generates no-arg constructor
            @AllArgsConstructor → generates all-args constructor
            @Builder → generates builder pattern
            @Slf4j → injects a 'log' field using SLF4J
            optional=true means it's not transitively passed to dependents.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            spring-boot-devtools:
            Enables automatic restart when classpath files change.
            Only active in development, excluded from production JARs.
            scope=runtime + optional=true ensures it's never bundled.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
            springdoc-openapi-starter-webmvc-ui:
            Generates Swagger UI and OpenAPI 3.0 documentation automatically
            by scanning your @RestController classes.
            Accessible at http://localhost:8080/swagger-ui/index.html
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!--
            spring-boot-starter-test:
            Bundles JUnit 5 + Mockito + MockMvc + AssertJ + Spring Test.
            scope=test means these classes are only available during testing,
            not included in the production JAR.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                spring-boot-maven-plugin:
                Packages your app as an executable "fat JAR" containing
                all dependencies + embedded Tomcat.
                'mvn spring-boot:run' uses this plugin to start the app.
                The excludes block prevents Lombok from being bundled
                since it's only needed at compile time.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
